# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this as a secret in the deployment environment. Never expose it to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional provider routing keys; configure only the providers enabled for your users.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""
# Server-side AI Provider API Keys
# Read strictly server-side; NEVER expose in client or React bundle.

# Firebase Admin uses the hosting service account via ADC in production.
# For local development only, set GOOGLE_APPLICATION_CREDENTIALS to a protected service-account file.

# Canonical HTTPS origin used for OAuth callbacks, e.g. https://float.example.com
APP_URL="https://your-domain.example"

# Required to encrypt OAuth tokens stored in Firestore. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOAT_OAUTH_ENCRYPTION_KEY=""

# Optional project execution sandbox. The app server invokes only the Docker CLI;
# keep the Docker daemon on a dedicated runner host and do not mount its socket
# into a public-facing application container. Use a preloaded image pinned by
# digest, with Node, npm, Python and common project tools installed.
# Configure the runner endpoint with mutual TLS. Without a dedicated tcp TLS
# runner, a shared filesystem path mounted at the same absolute path on both
# hosts, and a valid 64-character image digest, execution stays disabled.
FLOAT_DOCKER_BIN="/usr/bin/docker"
FLOAT_EXECUTION_IMAGE="registry.example/float-executor@sha256:replace-with-64-character-digest"
FLOAT_EXECUTION_SHARED_DIR="/var/lib/float-execution"
DOCKER_HOST="tcp://executor.internal:2376"
DOCKER_TLS_VERIFY="1"
DOCKER_CERT_PATH="/run/secrets/float-executor-client-certs"

# Agent worktrees are seeded from each task's authoritative saved-project snapshot.
# The default is an OS temp directory. Use a private writable scratch volume on the worker.
FLOAT_AGENT_WORKTREE_ROOT="/var/lib/float-agent-worktrees"
# Optional explicit Git executable; defaults to git on PATH.
FLOAT_GIT_BIN="/usr/bin/git"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: For GitHub OAuth integration.
# Register in GitHub Developer Settings -> OAuth Apps.
# Authorization Callback URL: https://your-domain.example/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional explicit callback override:
# GITHUB_CALLBACK_URL="https://float-studio.ai.studio/api/integrations/github/callback"

# GITLAB_CLIENT_ID & GITLAB_CLIENT_SECRET: For GitLab OAuth integration.
# Register in GitLab -> User Settings -> Applications.
# Redirect URI: https://your-domain.example/api/integrations/gitlab/callback
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
# Optional explicit callback override:
# GITLAB_CALLBACK_URL="https://float-studio.ai.studio/api/integrations/gitlab/callback"
