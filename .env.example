# =============================================================================
# FLOAT AI Studio — Server & Runtime Environment Configuration (.env.example)
# =============================================================================
# SECURITY NOTICE:
# - Never commit real API keys, service account JSON, or OAuth secrets to Git.
# - All model provider credentials and OAuth secrets are server-side only.
# - Never expose secret keys via VITE_* frontend variables or browser storage.
# =============================================================================

# --- Core Server & CORS ---
NODE_ENV=
PORT=
ALLOWED_ORIGINS=
FLOAT_PUBLIC_BASE_URL=

# --- Firebase Admin Durable State (Required in NODE_ENV=production) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- AI Model Providers (Server-Side Only) ---
OPENAI_API_KEY=
OPENAI_ENVIRONMENT_KEY=
CODEX_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
FLOAT_ANTHROPIC_MODEL_SONNET=
FLOAT_ANTHROPIC_MODEL_OPUS=
FLOAT_ANTHROPIC_MODEL_HAIKU=

# --- Isolated Docker Execution & Sandboxed PTY Terminal Runtime ---
# Required by ProjectProcessManager (src/server/execution/processManager.ts)
# and TerminalWsServer (src/server/terminal/terminalWsServer.ts):
# - FLOAT_DOCKER_BIN: Path to docker binary (e.g. /usr/bin/docker)
# - FLOAT_EXECUTION_IMAGE: Image pinned by SHA-256 digest (e.g. node:22-bookworm-slim@sha256:<64-hex-chars>)
# - DOCKER_HOST: TLS-secured TCP Docker daemon endpoint (e.g. tcp://127.0.0.1:2376)
# - DOCKER_TLS_VERIFY: Must be set to 1
# - DOCKER_CERT_PATH: Directory containing ca.pem, cert.pem, key.pem
# - FLOAT_EXECUTION_SHARED_DIR: Absolute path to 0700 directory owned by execution user
# - FLOAT_EXECUTION_UID / FLOAT_EXECUTION_GID: Non-root UID/GID for container user
FLOAT_DOCKER_BIN=
FLOAT_EXECUTION_IMAGE=
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=
FLOAT_EXECUTION_SHARED_DIR=
FLOAT_EXECUTION_UID=
FLOAT_EXECUTION_GID=
FLOAT_TERMINAL_IDLE_TIMEOUT_MS=

# --- OAuth, Source Control & Issue Tracking Integrations ---
FLOAT_OAUTH_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
FLOAT_ENABLE_MCP_STDIO=

# --- Stripe Billing & Subscriptions ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_YEARLY=
STRIPE_PRICE_ID_ULTRA=
STRIPE_PRICE_ID_ULTIMATE=
STRIPE_PRICE_ID_ULTIMATE_MONTHLY=
STRIPE_PRICE_ID_ULTIMATE_YEARLY=

# --- Privacy & Public Launch Governance ---
FLOAT_PRIVACY_CONTROLLER_NAME=
FLOAT_PRIVACY_CONTACT_EMAIL=
FLOAT_PRIVACY_RETENTION_DAYS=
FLOAT_PRIVACY_SUBPROCESSORS=
FLOAT_PRIVACY_JURISDICTIONS=
FLOAT_PRIVACY_RIGHTS_URL=
FLOAT_PRIVACY_APPROVED=