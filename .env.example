# ============================================================================
# FLOAT AI — Environment Variables (.env.example)
# Copy this file to .env and fill in the required values.
# Never commit real API keys or secrets to version control.
# ============================================================================

# --- Runtime & Server Configuration ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=0

# --- AI Provider API Keys (Server-Side Only) ---
# Google Gemini API Key (Required for Gemini models: gemini-4-argon, gemini-3.1-pro-preview, gemini-3-flash-preview, gemini-2.5-flash)
GEMINI_API_KEY=

# OpenAI API Key (Required for OpenAI models: gpt-6-astra, gpt-6-sol, gpt-6-luna)
OPENAI_API_KEY=

# Anthropic API Key (Required for Claude models: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5)
ANTHROPIC_API_KEY=

# --- Optional Provider Base URL Overrides & Model Overrides ---
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
FLOAT_OPENAI_MODEL_ASTRA=
FLOAT_OPENAI_MODEL_SOL=
FLOAT_OPENAI_MODEL_LUNA=
FLOAT_ANTHROPIC_MODEL_SONNET=
FLOAT_ANTHROPIC_MODEL_OPUS=
FLOAT_ANTHROPIC_MODEL_HAIKU=

# --- Cloud Agent Session & Environment IDs (Server-Side) ---
FLOAT_ASTRA_SESSION_ID=
FLOAT_ASTRA_ENVIRONMENT_ID=
FLOAT_SOL_SESSION_ID=
FLOAT_SOL_ENVIRONMENT_ID=
FLOAT_CLOUD_AGENT_REMOTE_URL=

# --- Firebase Admin & Project Configuration (Server-Side) ---
# JSON string containing the Firebase Admin Service Account key (Required in production for durable Firestore state)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
VITE_FIREBASE_PROJECT_ID=

# --- FLOAT Execution, Worker & Terminal Sandbox Settings ---
FLOAT_ENABLE_PORTABLE_FS=false
FLOAT_ENABLE_HOST_TERMINAL=false
FLOAT_TERMINAL_WS_ENABLED=true
FLOAT_MAX_TERMINAL_SESSIONS_PER_USER=2
FLOAT_MAX_TERMINAL_IDLE_MS=300000
FLOAT_MAX_TERMINAL_LIFETIME_MS=1800000
FLOAT_WORKER_ID=
FLOAT_WORKER_POLL_MS=2500
FLOAT_WORKER_LEASE_MS=60000

# --- GitHub OAuth & Webhook Integration ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- GitLab OAuth & Webhook Integration ---
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_WEBHOOK_SECRET=

# --- Linear OAuth & Webhook Integration ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# --- Slack OAuth & Webhook Integration ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Stripe Billing Integration (Optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ULTRA=
