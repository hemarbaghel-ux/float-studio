# FLOAT Studio server configuration template
# Keep all provider credentials server-side. Never commit real values.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Required for genuine OpenAI responses. Leave blank until configured on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required for cloud persistence in production. Use Application Default Credentials
# instead if the server runtime is configured with them.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional OAuth and billing integrations.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_YEARLY=
STRIPE_PRICE_ID_ULTIMATE=
STRIPE_PRICE_ID_ULTIMATE_MONTHLY=
STRIPE_PRICE_ID_ULTIMATE_YEARLY=

# Error Tracking & Telemetry (Optional)
# If empty or omitted, Sentry error tracking is completely disabled with zero runtime overhead.
SENTRY_DSN=
VITE_SENTRY_DSN=
