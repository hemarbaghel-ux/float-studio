{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A user's code project",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this project",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "The name of the project",
          "maxLength": 100
        },
        "files": {
          "type": "string",
          "description": "JSON stringified FileNode array representing the workspace",
          "maxLength": 1000000
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        }
      },
      "required": [
        "ownerId",
        "name",
        "files",
        "createdAt",
        "updatedAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A user's AI chat conversation thread associated with a project",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this conversation",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "description": "The project ID associated with this conversation",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Conversation title",
          "maxLength": 200
        },
        "messages": {
          "type": "string",
          "description": "JSON stringified recent conversation messages snapshot",
          "maxLength": 850000
        },
        "messageCount": {
          "type": "number",
          "description": "Total number of messages in the conversation"
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        }
      },
      "required": [
        "ownerId",
        "projectId",
        "title",
        "messages",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "Stores user subscription status, plan tier, and Stripe reference identifiers",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase user ID who owns the subscription",
          "maxLength": 128
        },
        "planId": {
          "type": "string",
          "description": "Current subscription plan identifier",
          "enum": [
            "free",
            "pro",
            "business",
            "ultimate"
          ]
        },
        "status": {
          "type": "string",
          "description": "Stripe subscription status",
          "enum": [
            "active",
            "trialing",
            "past_due",
            "canceled",
            "unpaid",
            "incomplete",
            "incomplete_expired"
          ]
        },
        "stripeCustomerId": {
          "type": "string",
          "description": "Stripe customer identifier"
        },
        "stripeSubscriptionId": {
          "type": "string",
          "description": "Stripe subscription identifier"
        },
        "currentPeriodEnd": {
          "type": "number",
          "description": "Unix timestamp in seconds when the current period ends"
        },
        "cancelAtPeriodEnd": {
          "type": "boolean",
          "description": "Whether the subscription is scheduled to cancel at period end"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when subscription was last updated"
        }
      },
      "required": [
        "userId",
        "planId",
        "status",
        "updatedAt"
      ]
    },
    "UserConsent": {
      "title": "UserConsent",
      "description": "User privacy and data-sharing consent record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this consent preference",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sharingEnabled": {
          "type": "boolean",
          "description": "Whether optional product-improvement data sharing is enabled"
        },
        "policyVersion": {
          "type": "string",
          "description": "Version identifier of the privacy policy consented to",
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "description": "Origin of the consent decision",
          "enum": [
            "onboarding",
            "settings",
            "default"
          ],
          "maxLength": 32
        },
        "consentTimestamp": {
          "type": "object",
          "description": "Timestamp when consent was recorded"
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp of last update"
        }
      },
      "required": [
        "userId",
        "sharingEnabled",
        "policyVersion",
        "source",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/userSubscriptions/{userId}": {
      "schema": {
        "$ref": "#/entities/UserSubscription"
      },
      "description": "Stores user subscription records verified via Stripe webhooks"
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores user projects"
    },
    "/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Stores user AI chat conversations"
    },
    "/userConsents/{userId}": {
      "schema": {
        "$ref": "#/entities/UserConsent"
      },
      "description": "Stores user privacy and data sharing consent preferences"
    }
  }
}