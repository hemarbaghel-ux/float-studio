rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidProject(data) {
      return data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             ((data.keys().hasAll(['ownerId', 'name', 'files', 'createdAt', 'updatedAt']) &&
               data.keys().size() == 5 && data.files is string && data.files.size() <= 1000000) ||
              (data.keys().hasAll(['ownerId', 'name', 'fileStorageVersion', 'fileGeneration', 'fileChunkCount', 'fileBytes', 'fileSnapshotComplete', 'createdAt', 'updatedAt']) &&
               data.keys().hasOnly(['ownerId', 'name', 'fileStorageVersion', 'fileGeneration', 'fileChunkCount', 'fileBytes', 'fileSnapshotComplete', 'createdAt', 'updatedAt']) &&
               data.fileStorageVersion == 2 && data.fileGeneration is string && data.fileGeneration.size() == 36 &&
               data.fileChunkCount is number && data.fileChunkCount >= 1 && data.fileChunkCount <= 1000000 &&
               data.fileBytes is number && data.fileBytes >= 2 && data.fileBytes <= 1000000000 &&
               data.fileSnapshotComplete is bool));
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'title', 'messages', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'projectId', 'title', 'messages', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.ownerId == request.auth.uid &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.messages is string && data.messages.size() <= 850000 &&
             (!data.keys().hasAny(['messageCount']) ||
              (data.messageCount is number && data.messageCount >= 0 && data.messageCount <= 1000000));
    }

    function isValidUserConsent(data) {
      return data.keys().hasAll(['userId', 'sharingEnabled', 'policyVersion', 'source', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'sharingEnabled', 'policyVersion', 'source', 'consentTimestamp', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.sharingEnabled is bool &&
             data.policyVersion is string && data.policyVersion.size() <= 32 &&
             data.source in ['onboarding', 'settings', 'default'];
    }
    
    match /userConsents/{userId} {
      allow read, delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUserConsent(incoming()) &&
                    incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() &&
                    isValidId(userId) &&
                    userId == request.auth.uid &&
                    isValidUserConsent(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['sharingEnabled', 'policyVersion', 'source', 'consentTimestamp', 'updatedAt']);
    }

    match /projects/{projectId} {
      allow read, delete: if isSignedIn() && (resource == null || existing().ownerId == request.auth.uid);
      
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                    isValidId(projectId) &&
                    isValidProject(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() &&
                    isValidId(projectId) &&
                    isValidProject(incoming()) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'files', 'updatedAt', 'fileStorageVersion', 'fileGeneration', 'fileChunkCount', 'fileBytes', 'fileSnapshotComplete']);

      match /projectContent/{contentId} {
        function ownsParentProject() {
          return isSignedIn() &&
                 exists(/databases/$(database)/documents/projects/$(projectId)) &&
                 get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        }

        allow read: if ownsParentProject() && (resource == null || resource.data.ownerId == request.auth.uid);

        allow create, update: if ownsParentProject() &&
          contentId.matches('^[a-f0-9-]{36}_[0-9]{8}$') &&
          incoming().keys().hasOnly(['ownerId', 'generation', 'index', 'content']) &&
          incoming().ownerId == request.auth.uid &&
          incoming().generation is string && incoming().generation.size() == 36 &&
          incoming().index is number && incoming().index >= 0 && incoming().index <= 1000000 &&
          incoming().content is string && incoming().content.size() <= 614400;

        allow delete: if ownsParentProject() && (resource == null || resource.data.ownerId == request.auth.uid);
      }
    }

    match /conversations/{conversationId} {
      allow read, delete: if isSignedIn() && (resource == null || existing().ownerId == request.auth.uid);
      
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                    isValidId(conversationId) &&
                    isValidConversation(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
                    
      allow update: if isSignedIn() &&
                    isValidId(conversationId) &&
                    isValidConversation(incoming()) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'messageCount', 'updatedAt']);

      match /messages/{messageId} {
        function ownsParentConversation() {
          return isSignedIn() &&
                 exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                 get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;
        }

        allow read: if ownsParentConversation();

        allow create, update: if ownsParentConversation() &&
          incoming().ownerId == request.auth.uid &&
          ((messageId == '__manifest__' &&
            incoming().keys().hasOnly(['ownerId', 'generation', 'previousGeneration', 'count', 'complete']) &&
            incoming().generation is string && incoming().generation.size() == 36 &&
            (!incoming().keys().hasAny(['previousGeneration']) ||
             (incoming().previousGeneration is string && incoming().previousGeneration.size() == 36)) &&
            incoming().count is number && incoming().count >= 0 &&
            incoming().count <= 1000000 && incoming().complete is bool) ||
           (messageId.matches('^[a-f0-9-]{36}_[0-9]{8}$') &&
            incoming().keys().hasOnly(['ownerId', 'generation', 'index', 'message']) &&
            incoming().generation is string && incoming().generation.size() == 36 &&
            incoming().index is number && incoming().index >= 0 &&
            incoming().index <= 1000000 && incoming().message is string &&
            incoming().message.size() <= 850000));

        allow delete: if ownsParentConversation() &&
          (messageId == '__manifest__' || messageId.matches('^[a-f0-9-]{36}_[0-9]{8}$'));
      }
    }

    match /userSubscriptions/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only server-side via verified Stripe webhooks
    }

    match /processedWebhookEvents/{eventId} {
      allow read, write: if false; // Strictly server-side
    }

    match /userTokenUsage/{usageId} {
      allow read, write: if false; // Strictly server-side token usage metering
    }

    // Server-only durable state & background worker collections (Admin SDK only; browser access strictly denied)
    match /codeProposals/{proposalId} {
      allow read, write: if false;
      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    match /server_proposals/{proposalId} {
      allow read, write: if false;
    }

    match /server_terminal_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /server_custom_skills/{skillId} {
      allow read, write: if false;
    }

    match /server_execution_policies/{userId} {
      allow read, write: if false;
    }

    match /server_cloud_agent_sessions/{userId} {
      allow read, write: if false;
    }

    match /server_rate_limits/{rateLimitKey} {
      allow read, write: if false;
    }

    match /agentTasks/{taskId} {
      allow read, write: if false;
    }

    match /agentTaskEvents/{eventId} {
      allow read, write: if false;
    }

    match /agentTaskResults/{taskId} {
      allow read, write: if false;
    }

    match /agentTaskWorkspaces/{taskId} {
      allow read, write: if false;
      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    match /agentProjectLeases/{leaseId} {
      allow read, write: if false;
    }

    match /server_checkpoints/{checkpointId} {
      allow read, write: if false;
      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }
  }
}
