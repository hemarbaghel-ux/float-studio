{
  "name": "float-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/devAll.mjs",
    "dev:server": "node --import tsx server.ts",
    "build": "npm run build:web && npm run build:server && npm run build:extensions && npm run build:desktop-extensions",
    "build:web": "vite build",
    "build:server": "esbuild src/server/app.ts --platform=node --format=cjs --packages=external --bundle --sourcemap --outfile=dist/server.cjs && esbuild src/server/app.ts --platform=node --format=esm --packages=external --bundle --sourcemap --outfile=dist/server.js",
    "build:float-daemon-worker": "node scripts/buildFloatDaemonWorker.mjs",
    "build:extensions": "node scripts/buildAllBuiltinExtensions.cjs",
    "build:desktop-extensions": "node scripts/buildAllDesktopExtensions.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:desktop": "node node_modules/tsx/dist/cli.mjs scripts/testNativeDesktopSmoke.ts",
    "test:repo": "node node_modules/tsx/dist/cli.mjs scripts/testRepositoryStructureIntegrity.ts",
    "package:desktop": "node scripts/packageDesktopRelease.cjs",
    "validate:release": "node scripts/validateReleaseArtifacts.cjs",
    "clean": "node scripts/clean.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google-cloud/firestore": "^9.4.0",
    "@google/genai": "^2.4.0",
    "@monaco-editor/loader": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.43.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "node-pty": "^1.1.0",
    "openai": "^6.20.0",
    "pg": "^8.13.1",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
