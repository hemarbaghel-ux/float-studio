{
  "name": "html-language-features",
  "displayName": "HTML Language Features",
  "description": "Provides rich language support, tag auto-closing, and formatting for HTML in FLOAT Studio",
  "version": "1.0.0",
  "publisher": "float-ai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "html",
        "aliases": ["HTML", "htm", "html", "xhtml"],
        "extensions": [".html", ".htm", ".shtml", ".xhtml", ".inc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "html.autoCloseTag",
        "title": "HTML: Auto Close Tag",
        "category": "HTML"
      }
    ]
  }
}
