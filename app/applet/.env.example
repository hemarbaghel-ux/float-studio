# FLOAT AI Environment Configuration Example (No Secrets)

# Primary OpenAI API Key (Standard chat, completion, and agent routing)
OPENAI_API_KEY=your_openai_api_key_here

# GPT-6 Astra Preview / Cloud Agent Environment Key (Codex execution server)
OPENAI_ENVIRONMENT_KEY=your_openai_environment_key_here
CODEX_API_KEY=your_codex_api_key_here

# Application Configuration
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Optional Developer Integrations
FLOAT_OAUTH_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
