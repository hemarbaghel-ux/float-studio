    content: "{\n  \"name\": \"float-studio\",\n  \"private\": true,\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=20.0.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"tsx server.ts\",\n    \"dev:node\": \"node node_modules/tsx/dist/cli.mjs server.ts\",\n    \"start\": \"node server.ts\",\n    \"test\": \"tsx scripts/testPhaseASecurityRegression.ts && tsx scripts/testMasterAuditRegression.ts && tsx scripts/testCodebaseSearch.ts && tsx scripts/testProjectExecution.ts && tsx scripts/testPhase5Proposal.ts && tsx scripts/testPhase6Validation.ts && tsx scripts/testPhase7FinalIntegration.ts && tsx scripts/testAutomationIsolation.ts && tsx scripts/testPortableAgentRunner.ts && tsx scripts/testAgentOrchestratorValidation.ts && tsx scripts/testAgentGitWorktree.ts && tsx scripts/testSecurityAudit.ts && tsx scripts/testProviderRoutingAndHealth.ts && tsx scripts/testFloatBasicModel.ts && tsx scripts/testMilestone4.ts && tsx scripts/testMilestone5.ts && tsx scripts/testMilestone6.ts && tsx scripts/testMilestone7.ts && tsx scripts/testMilestone8.ts && tsx scripts/testMilestone9AgentModes.ts && tsx scripts/testMilestone9Rules.ts && tsx scripts/testMilestone9Skills.ts && tsx scripts/testMilestone9Hooks.ts && tsx scripts/testMilestone9MCP.ts && tsx scripts/testMilestone9Browser.ts && tsx scripts/testMilestone9CloudAgents.ts && tsx scripts/testMilestone9Subagents.ts && tsx scripts/testMilestone9Automations.ts && tsx scripts/testMilestone9Memory.ts && tsx scripts/testMilestone9Review.ts && tsx scripts/testMilestone9Security.ts && tsx scripts/testMilestone9E2E.ts && tsx scripts/testCursorParityWebsite.ts && tsx scripts/testTenantIsolationSecurity.ts && tsx scripts/testAccountMenuSystem.ts && tsx scripts/testAuthPersistence.ts && tsx scripts/testDeleteConversationPermissions.ts && tsx scripts/testErrorResilience.ts && tsx scripts/testGitHubIntegration.ts && tsx scripts/testMilestone3.ts && tsx scripts/testMilestones1And2.ts && tsx scripts/testModelSelectorPanel.ts && tsx scripts/testNewChatLifecycle.ts && tsx scripts/testServerAgentLoop.ts && tsx scripts/testStage1Navigation.ts && tsx scripts/testStageBChatReliability.ts && tsx scripts/verifyBrowserE2E.ts && tsx scripts/testWebsiteExperienceEnhancement.ts\",\n    \"build\": \"vite build && esbuild src/server/app.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@anthropic-ai/sdk\": \"^0.131.0\",\n    \"@google/genai\": \"^2.4.0\",\n    \"@monaco-editor/react\": \"^4.7.0\",\n    \"@stripe/stripe-js\": \"^10.0.0\",\n    \"@tailwindcss/typography\": \"^0.5.20\",\n    \"@tailwindcss/vite\": \"^4.1.14\",\n    \"@vitejs/plugin-react\": \"^5.0.4\",\n    \"clsx\": \"^2.1.1\",\n    \"diff\": \"^9.0.0\",\n    \"dotenv\": \"^17.2.3\",\n    \"drizzle-kit\": \"^0.31.11\",\n    \"drizzle-orm\": \"^0.45.4\",\n    \"esbuild\": \"^0.25.0\",\n    \"express\": \"^4.21.2\",\n    \"firebase\": \"^12.18.0\",\n    \"firebase-admin\": \"^14.5.0\",\n    \"jszip\": \"^3.10.2\",\n    \"lucide-react\": \"^0.546.0\",\n    \"motion\": \"^12.23.24\",\n    \"openai\": \"^7.27.0\",\n    \"pg\": \"^8.23.1\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"react-markdown\": \"^10.1.0\",\n    \"react-resizable-panels\": \"^4.12.3\",\n    \"recharts\": \"^3.10.1\",\n    \"stripe\": \"^23.0.0\",\n    \"tailwind-merge\": \"^3.6.0\",\n    \"uuid\": \"^14.0.2\",\n    \"vite\": \"^6.2.3\",\n    \"zustand\": \"^5.0.15\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^22.14.0\",\n    \"@types/pg\": \"^8.23.1\",\n    \"@types/uuid\": \"^11.0.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.25.0\",\n    \"sharp\": \"^0.35.4\",\n    \"tailwindcss\": \"^4.1.14\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"~5.8.2\",\n    \"vite\": \"^6.2.3\"\n  },\n  \"overrides\": {