  view_file {
    absolute_path_uri: "file:///src/index.css"
    end_line: 231
    content: "@import \"tailwindcss\";\n@plugin \"@tailwindcss/typography\";\n\n@custom-variant dark (&:where(.dark, .dark *));\n\n/* Base Theme & Color Scheme Synchronization */\nhtml.dark, html[data-theme=\"dark\"] {\n  color-scheme: dark;\n  background-color: #0A0A0A;\n  color: #C9D1D9;\n}\n\nhtml.light, html[data-theme=\"light\"] {\n  color-scheme: light;\n  background-color: #F8F8F7;\n  color: #0F172A;\n}\n\nbody {\n  background-color: inherit;\n  color: inherit;\n  margin: 0;\n  padding: 0;\n}\n\n/* FLOAT Motion & Animation Design Tokens (Synced with src/lib/animations.ts) */\n:root {\n  --float-duration-instant: 100ms;\n  --float-duration-fast: 150ms;\n  --float-duration-normal: 200ms;\n  --float-duration-moderate: 300ms;\n  --float-duration-slow: 500ms;\n  --float-duration-logo-hover: 600ms;\n  --float-duration-logo-spin: 600ms;\n  --float-duration-logo-rotate: 600ms;\n\n  --float-ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);\n  --float-ease-settle: cubic-bezier(0.16, 1, 0.3, 1);\n  --float-ease-tilt: cubic-bezier(0.16, 1, 0.3, 1);\n  --float-ease-rotate: cubic-bezier(0.22, 1, 0.36, 1);\n  --float-ease-out-expo: cubic-bezier(0.19, 1, 0.22, 1);\n  --float-ease-in-out: cubic-bezier(0.42, 0, 0.58, 1);\n}\n\n/* FLOAT Logo Subtle 360-Degree Rotation Animation for Active & Hover State */\n@keyframes floatLogoRotate360 {\n  0% {\n    transform: perspective(400px) rotate(0deg) scale(1);\n    filter: drop-shadow(0 0 0px rgba(0, 0, 0, 0));\n  }\n  50% {\n    transform: perspective(400px) rotate(180deg) scale(1.05);\n    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.25)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));\n  }\n  100% {\n    transform: perspective(400px) rotate(360deg) scale(1);\n    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.12));\n  }\n}\n\n/* FLOAT Logo Refined 3D Tilt & Floating Elevation */\n@keyframes floatLogoTiltElevate {\n  0% {\n    transform: perspective(400px) rotateX(0deg) rotateY(0deg) translateY(0) scale(1);\n    filter: drop-shadow(0 0 0px rgba(0, 0, 0, 0));\n  }\n  50% {\n    transform: perspective(400px) rotateX(-8deg) rotateY(12deg) translateY(-3px) scale(1.05);\n    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.28)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.16));\n  }\n  100% {\n    transform: perspective(400px) rotateX(-5deg) rotateY(8deg) translateY(-2px) scale(1.04);\n    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.22)) drop-shadow(0 1px 3px rgba(0, 0, 0, 0.12));\n  }\n}\n\n/* FLOAT Logo Monochrome Glass Sheen Sweep */\n@keyframes floatLogoSheen {\n  0% {\n    transform: translateX(-150%) skewX(-25deg);\n    opacity: 0;\n  }\n  20% {\n    opacity: 0.65;\n  }\n  80% {\n    opacity: 0.65;\n  }\n  100% {\n    transform: translateX(150%) skewX(-25deg);\n    opacity: 0;\n  }\n}\n\n/* Soft Monochromatic Elevation Aura */\n@keyframes floatLogoElevationAura {\n  0% {\n    opacity: 0;\n    transform: scale(0.85);\n  }\n  40% {\n    opacity: 0.45;\n    transform: scale(1.12);\n  }\n  100% {\n    opacity: 0.25;\n    transform: scale(1.06);\n  }\n}\n\n/* FLOAT Authentication Experience Ambient Motion */\n@keyframes floatAuthAmbientPulse {\n  0%, 100% {\n    opacity: 0.35;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.65;\n    transform: scale(1.04);\n  }\n}\n\n.float-auth-ambient-pulse {\n  animation: floatAuthAmbientPulse 7s ease-in-out infinite;\n}\n\n/* Subtle 360-degree rotation animation triggered on active state, hover, or focus */\n.float-logo-rotate-360,\n.float-logo-emblem-spin,\n.float-logo-active .float-logo-emblem,\n.float-logo-interactive.is-active .float-logo-emblem,\n.float-logo-interactive[data-active=\"true\"] .float-logo-emblem,\n.float-logo-container:hover .float-logo-emblem,\n.float-logo-interactive:hover .float-logo-emblem,\n.group:hover .float-logo-interactive .float-logo-emblem,\n.group:hover .float-logo-emblem,\n.float-logo-emblem.is-active,\n.float-logo-emblem:active,\n.float-logo-tilt-elevate {\n  animation: floatLogoRotate360 var(--float-duration-logo-rotate) var(--float-ease-rotate) 1 forwards;\n  transform-origin: center center;\n  will-change: transform, filter;\n}\n\n.float-logo-sheen,\n.float-logo-active .float-logo-sheen-sweep,\n.float-logo-interactive.is-active .float-logo-sheen-sweep,\n.float-logo-interactive[data-active=\"true\"] .float-logo-sheen-sweep,\n.float-logo-container:hover .float-logo-sheen-sweep,\n.float-logo-interactive:hover .float-logo-sheen-sweep,\n.group:hover .float-logo-interactive .float-logo-sheen-sweep,\n.group:hover .float-logo-sheen-sweep {\n  animation: floatLogoSheen var(--float-duration-logo-rotate) var(--float-ease-rotate) 1 forwards;\n  will-change: transform, opacity;\n}\n\n.float-logo-elevation-aura,\n.float-logo-active .float-logo-aura-sweep,\n.float-logo-interactive.is-active .float-logo-aura-sweep,\n.float-logo-interactive[data-active=\"true\"] .float-logo-aura-sweep,\n.float-logo-container:hover .float-logo-aura-sweep,\n.float-logo-interactive:hover .float-logo-aura-sweep,\n.group:hover .float-logo-interactive .float-logo-aura-sweep,\n.group:hover .float-logo-aura-sweep,\n.float-logo-aura-pulse {\n  animation: floatLogoElevationAura var(--float-duration-logo-rotate) var(--float-ease-rotate) 1 forwards;\n  will-change: opacity, transform;\n}\n\n/* Marquee Animation for Developer Testimonials */\n@keyframes floatMarquee {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n@keyframes floatMarqueeReverse {\n  0% {\n    transform: translateX(-50%);\n  }\n  100% {\n    transform: translateX(0);\n  }\n}\n\n.float-marquee-track {\n  display: flex;\n  width: max-content;\n  animation: floatMarquee 38s linear infinite;\n  will-change: transform;\n}\n\n.float-marquee-track-reverse {\n  display: flex;\n  width: max-content;\n  animation: floatMarqueeReverse 42s linear infinite;\n  will-change: transform;\n}\n\n.float-marquee-paused {\n  animation-play-state: paused !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .float-logo-tilt-elevate,\n  .float-logo-emblem-spin,\n  .float-logo-sheen,\n  .float-auth-ambient-pulse,\n  .float-marquee-track,\n  .float-marquee-track-reverse {\n    animation: none !important;\n    transform: none !important;\n    filter: none !important;\n  }\n  .float-logo-elevation-aura,\n  .float-logo-aura-pulse {\n    animation: none !important;\n    opacity: 0 !important;\n  }\n}\n\n@media (hover: none) {\n  .float-logo-elevation-aura,\n  .float-logo-aura-pulse,\n  .float-logo-sheen {\n    display: none !important;\n  }\n}\n"
    num_lines: 232
    num_bytes: 6253
    line_range_bytes: 6253
  }
}
